<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sh_rr_payment_receipt_document">
        <t t-set="o" t-value="o.with_context(lang=lang)"/>
        <t t-set="invoices" t-value="o.reconciled_invoice_ids or o.reconciled_bill_ids"/>

        <style>
            th {
                vertical-align: baseline;
                text-align: center;
            }
            p, span, div, td, th {
                font-weight: 400;
                color: #000000;
                font-family: "DejaVu Sans", sans-serif;
            }
            strong {
                color: #000000 !important;
            }
            .tax_invoice_text span {
                font-size: 30px
            }
            address span {
                color: #2b2775 !important;
            }
            .border-top-grey {
                border-top: 1px solid grey !important;
            }
        </style>

        <table class="mw-sheet" style="width: 100%; height: 270mm; border-collapse: collapse;">
        <tr>
        <td style="vertical-align: top; padding: 0;">
        <table class="mw-header" style="width: 100%; border-collapse: collapse;" cellspacing="0" cellpadding="0">
            <tr>
            <td style="width: 58%; vertical-align: top; padding: 0;">
                <table style="width: 100%;" cellspacing="0">
                    <thead>
                        <tr>
                            <td colspan="2" style="padding-left: 2%;padding-top: 3%;background: #2b2775;">
                                <h2 style="font-family: 'Brush Script MT', cursive;color: #ffffff">Excellence in Print &amp; Media</h2>
                            </td>
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="height: 8px"/>
                        <tr>
                            <td rowspan="2" style="padding-left: 2%;border-right: 1px solid #2b2775;" class="tax_invoice_text">
                                <h3>
                                   RECEIPT
                                </h3>
                            </td>
                            <td style="padding: 10px;">
                                <b style="color: #2b2775;">Date:</b>
                                <span style="color: #2b2775;" class="m-0" t-field="o.date"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 10px;">
                                <b style="color: #2b2775;">Serial No:</b>
                                <span style="color: #2b2775;" t-if="o.name != '/'" t-field="o.name"/>
                            </td>
                        </tr>
                        <tr style="height: 5px"/>
                        <tr style="background: #d5d4e3;">
                            <td colspan="2" style="padding: 10px 13px;">
                                <div style="display: inline;">
                                    <t t-if="o.partner_type == 'customer'">
                                        <strong style="color: #2b2775;">Client: </strong>
                                    </t>
                                    <t t-if="o.partner_type == 'supplier'">
                                        <strong style="color: #2b2775;">Vendor: </strong>
                                    </t>
                                </div>
                                <div style="display: inline;">
                                    <span style="color: #2b2775 !important;" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                                    <div t-if="o.partner_id.vat" class="mt16">
                                        <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                                        <t t-else="">
                                            <span style="color: #2b2775;">Tax ID</span>
                                        </t>:
                                        <span style="color: #2b2775;" t-field="o.partner_id.vat"/>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
            <td style="width: 42%; vertical-align: top; padding: 0 0 0 8px;">
                <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" alt="Logo" style="display: block; margin: 0 0 6px 0; padding: 0; width: 180px;"/>
                <div>
                        <span style="color: #2b2775;font-size:13px;">
                            <b>Supplier:</b>
                        </span>
                        <br/>
                        <span style="color: #2b2775;font-size:13px;">MIDWESTERN GROUP LTD Room 1F-16 Jenna Plaza,
                        Plot 19 Nkrumah Road P. O. BOX 35178 KAMPALA</span>
                        <br/>
                        <span style="color: #2b2775;font-size:13px;">
                            <b>TEL:</b>     0702 199040/ 0788 465577</span>
                        <br/>
                        <span style="color: #2b2775;font-size:13px;">
                            <b>Email:</b>     midwesterngroup@gmail.com</span>
                        <br/>
                        <span style="color: #2b2775;font-size:13px;">
                            <b>Web:</b>     www.midwesternug.com</span>
                        <br/>
                        <span style="color: #2b2775;font-size:13px;">
                            <b>TIN No:.</b>   1001034097</span>
                        <br/>
                        <span style="color: #2b2775;font-size:13px;">
                            <b>VAT No:.</b>   1001034097</span>
                </div>
            </td>
            </tr>
        </table>
        <br/>

        <div class="page" style="display: block !important;">
            <div style="display:block !important;overflow: auto !important;">
                <div style="display: inline;width: 50%;float: left;" t-if="o.amount">
                    <strong>Payment Amount: </strong>
                    <span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                </div>
                <div style="display: inline;width: 50%;float: right;" t-if="o.memo">
                    <strong>Memo: </strong>
                    <span t-field="o.memo"/>
                </div>
            </div>

            <div class="row mt64">
                <div class="col-6" t-if="o.payment_method_line_id">
                   <strong>Payment Method: </strong>
                    <span t-field="o.payment_method_line_id.name"/>
                </div>
            </div>

            <br/>
            <table class="table table-sm o_main_table" name="invoice_line_table" style="width: 100%;" cellspacing="0">
                <thead>
                    <tr>
                        <th name="th_description" class="text-left" style="text-align: left !important;border:1px solid #ddd;">
                            <b>Description</b>
                        </th>
                        <th name="th_quantity" class="text-center" style="text-align:center !important;border:1px solid #ddd;">
                            <b>Quantity</b>
                        </th>
                    </tr>
                </thead>
                <tbody class="invoice_tbody">
                    <t t-foreach="invoices" t-as="inv">
                        <t t-foreach="inv.invoice_line_ids.filtered(lambda l: l.display_type == 'product')" t-as="line">
                            <tr>
                                <td style="border:1px solid #ddd;">
                                    <span t-field="line.product_id.name"/>
                                    <span t-if="not line.product_id" t-field="line.name"/>
                                </td>
                                <td class="text-center" style="text-align:center !important;border:1px solid #ddd;">
                                    <span t-field="line.quantity"/>
                                    <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>
            <br/>

            <table class="table table-sm" style="width: 100%;" cellspacing="0">
                <thead>
                    <tr>
                        <th style="text-align:center !important;border:1px solid #ddd;padding: 5px;">
                            <b>Invoice Date</b>
                        </th>
                        <th style="text-align:center !important;border:1px solid #ddd;padding: 5px;">
                            <b>Invoice Number</b>
                        </th>
                        <th style="text-align:center !important;border:1px solid #ddd;padding: 5px;">
                            <b>Reference</b>
                        </th>
                        <th style="text-align:center !important;border:1px solid #ddd;padding: 5px;">
                            <b>Original Amount</b>
                        </th>
                        <th style="text-align:center !important;border:1px solid #ddd;padding: 5px;">
                            <b>Amount Paid</b>
                        </th>
                        <th style="text-align:center !important;border:1px solid #ddd;padding: 5px;">
                            <b>Balance</b>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="invoices" t-as="inv">
                        <t t-set="partials" t-value="inv._get_reconciled_invoices_partials()[0]"/>
                        <t t-set="amount" t-value="sum(par[1] for par in partials if par[2].move_id == o.move_id)"/>
                        <tr>
                            <td style="text-align:center !important;border:1px solid #ddd;">
                                <span t-field="inv.invoice_date"/>
                            </td>
                            <td style="text-align:center !important;border:1px solid #ddd;">
                                <span t-field="inv.name"/>
                            </td>
                            <td style="text-align:center !important;border:1px solid #ddd;">
                                <span t-field="inv.ref"/>
                            </td>
                            <td style="text-align:center !important;border:1px solid #ddd;">
                                <span t-field="inv.amount_total"/>
                            </td>
                            <td style="text-align:center !important;border:1px solid #ddd;">
                                <span t-out="amount" t-options="{'widget': 'monetary', 'display_currency': inv.currency_id}"/>
                            </td>
                            <td style="text-align:center !important;border:1px solid #ddd;">
                                <span t-field="inv.amount_residual"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
        </td>
        </tr>
        <tr>
        <td style="vertical-align: bottom; padding: 8px 0 0 0;">
            <t t-call="midwestern_group.mw_client_notes"/>
        </td>
        </tr>
        </table>
    </template>

    <template id="sh_rr_payment_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang or o.company_id.partner_id.lang"/>
                <t t-call="midwestern_group.sh_rr_payment_receipt_document" t-lang="lang"/>
            </t>
        </t>
    </template>
</odoo>
